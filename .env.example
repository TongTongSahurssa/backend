SPRING_PROFILES_ACTIVE=prod
PORT=8080

PGHOST=your-postgres-private-host
PGPORT=5432
PGDATABASE=resume_admin
PGUSER=resume_admin
PGPASSWORD=replace-me
DB_POOL_SIZE=5

JWT_SECRET=generate-a-random-secret-of-at-least-32-bytes
SECURE_COOKIES=true

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-email@gmail.com
SMTP_PASSWORD=use-a-new-google-app-password
MAIL_FROM=your-email@gmail.com
MAIL_DEVELOPMENT_MODE=false
